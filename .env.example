#FP_NODE_IMAGE=registry.werk.local/node:22-alpine
#FP_NGINX_IMAGE=registry.werk.local/nginx:1.27-alpine
#FP_POSTGRES_IMAGE=registry.werk.local/postgres:16-alpine
#FP_CLAMAV_IMAGE=registry.werk.local/clamav/clamav:1.4
# false = install postgresql-client-16 from the base distribution instead of apt.postgresql.org
#FP_BUILD_PGDG=true
