# Copy to .env and adjust. Never commit .env.
POSTGRES_DB=factorypulse
POSTGRES_USER=factorypulse
POSTGRES_PASSWORD=change-me-to-a-long-random-password

FP_HTTP_PORT=8080
# production (customer installation) | demo (public demonstration with SYNTHETIC data)
FP_ENVIRONMENT=production
FP_MAX_UPLOAD_MB=10
# Max. size of one Action Center evidence file (PDF/PNG/JPEG/CSV/XLSX)
FP_MAX_EVIDENCE_MB=10
FP_MAX_IMPORT_ROWS=100000
# Load the 90-day SYNTHETIC demo dataset on the very first start (empty database only).
# Leave empty: automatic = never in production, yes for FP_ENVIRONMENT=demo/development.
# Setting true in production is an explicit opt-in and logs a warning.
FP_SEED_DEMO_ON_STARTUP=
# Demo tools (reload demo data / delete all data). Empty = off in production, on for demo.
FP_ENABLE_DEMO_TOOLS=

# --- Security ---------------------------------------------------------------
# First administrator, created once on first start if no user exists. They must change the
# password at first sign-in. Remove both values from .env afterwards.
FP_INITIAL_ADMIN_EMAIL=admin@example.com
FP_INITIAL_ADMIN_PASSWORD=
# Secure cookie flag: keep true. Browsers accept secure cookies on http://localhost; for several users
# in the LAN use the HTTPS mode (docker-compose.lan.yml) instead of disabling this.
FP_COOKIE_SECURE=true
FP_SESSION_IDLE_MINUTES=120
FP_SESSION_ABSOLUTE_HOURS=12

FP_TIMEZONE=Europe/Berlin
FP_BACKUP_RETENTION=14
FP_CORS_ORIGINS=http://localhost:8080
FP_LOG_LEVEL=INFO

# --- HTTPS for multi-user LAN installations (docker-compose.lan.yml, docs/INSTALLATION.md) -------
# Public URL users type in the browser (also the target of the HTTP->HTTPS redirect). Set
# FP_CORS_ORIGINS to the same value.
FP_PUBLIC_URL=
# directory with server.crt (full chain) and server.key – see ops/generate-tls-cert.sh
FP_TLS_DIR=./tls
FP_HTTPS_PORT=443
FP_HTTP_REDIRECT_PORT=80

# --- Background worker ---------------------------------------------------------------------------
# Action Center alert rules are evaluated by the "worker" service on this schedule (seconds)
FP_ALERT_INTERVAL_SECONDS=300
FP_JOB_MAX_ATTEMPTS=3

# --- Malware scanning of evidence files ----------------------------------------------------------
# none    – no scanner: uploads stay quarantined until an administrator releases them
# clamd   – ClamAV daemon (set COMPOSE_PROFILES=clamav to start the bundled clamav container)
# command – existing scanner CLI inside the backend image (FP_EVIDENCE_SCAN_COMMAND)
FP_EVIDENCE_SCANNER=none
#COMPOSE_PROFILES=clamav
#FP_EVIDENCE_SCAN_COMMAND=clamdscan --no-summary --fdpass
# v0.3.3: the worker runs an explicit scanner health check every cycle (PING/VERSION or a test scan of a
# clean and the harmless EICAR sample). Set to false only if your scanner must not see the EICAR string.
#FP_EVIDENCE_SCANNER_SELFTEST_EICAR=true
#FP_EVIDENCE_SCAN_MAX_ATTEMPTS=5
# seconds after which unreferenced evidence files (crash between file write and DB commit) go to evidence/orphaned
#FP_EVIDENCE_ORPHAN_GRACE_SECONDS=3600

